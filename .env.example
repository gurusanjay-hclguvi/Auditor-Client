# Copy to .env.local to run against the Go backend (audit-checker-backend).
# Leave VITE_USE_MOCK_API unset (or true) to run on the in-browser mock data instead.
VITE_USE_MOCK_API=false
# API calls go to /api/sales-audit/..., which the Vite dev server proxies to DEV_API_TARGET.
VITE_BASE_URL=/api
DEV_API_TARGET=http://127.0.0.1:8080
